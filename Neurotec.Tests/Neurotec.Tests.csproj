<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Neurotec">
      <HintPath>..\libs\Neurotec\Neurotec.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Neurotec.Biometrics">
      <HintPath>..\libs\Neurotec\Neurotec.Biometrics.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Neurotec.Biometrics.Client">
      <HintPath>..\libs\Neurotec\Neurotec.Biometrics.Client.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Neurotec.Devices">
      <HintPath>..\libs\Neurotec\Neurotec.Devices.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Neurotec.Licensing">
      <HintPath>..\libs\Neurotec\Neurotec.Licensing.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Neurotec.Media">
      <HintPath>..\libs\Neurotec\Neurotec.Media.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\libs\Neurotec\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(RecursiveDir)%(FileName)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neurotec.Infrastructure\Neurotec.Infrastructure.csproj" />
    <ProjectReference Include="..\Neurotec.Domain\Neurotec.Domain.csproj" />
    <ProjectReference Include="..\Neurotec.Application\Neurotec.Application.csproj" />
  </ItemGroup>

</Project>
