{
  "ServiceSettings": {
    "HttpPort": 3000,
    "ServiceName": "Neurotec Biometric Service",
    "WebRoot": "wwwroot"
  },
  "NeurotecSdk": {
    "LicenseKey": "TRIAL-LICENSE",
    "LicenseServer": "/trial",
    "DatabasePath": "fingerprints.db",
    "DatabasePassword": "vfs_demo_pass",
    "Components": [
      "Biometrics.Client",
      "Devices.FingerScanner"
    ],
    "CaptureSettings": {
      "TimeoutMs": 15000,
      "QualityThreshold": 40,
      "MaxRetries": 3
    },
    "DeviceSettings": {
      "ScannerModel": "Auto",
      "Resolution": 500,
      "AutoDetect": true,
      "DefaultWidth": 256,
      "DefaultHeight": 360
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}